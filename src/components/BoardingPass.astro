---
import LogoGraphic from "@images/logo.svg";
import { airports, homeAirport } from "@data/airports";
import { calculateTripStats } from "@data/stats";

const stats = calculateTripStats();

const passStats = [
  { label: "Airports", value: stats.totalAirports },
  { label: "Trips", value: stats.totalTrips },
  { label: "Flights", value: stats.totalFlights },
  { label: "Miles", value: Math.round(stats.totalMiles).toLocaleString("en-US") },
];

const { longestFlight } = stats;
const EARTH_CIRCUMFERENCE_MILES = 24901;
const timesAroundEarth = (stats.totalMiles / EARTH_CIRCUMFERENCE_MILES).toFixed(1);

// Decorative barcode whose bars are derived from the visited airport codes
let x = 0;
const bars = [...airports.map((airport) => airport.code).join("")].map(
  (letter) => {
    const code = letter.charCodeAt(0);
    const bar = { x, width: 1 + (code % 3) };
    x += bar.width + 1 + ((code >> 2) % 2);
    return bar;
  },
);
const barcodeWidth = x;
---

<header
  class="relative flex flex-col overflow-hidden border border-yellow text-left sm:flex-row"
>
  <div class="flex flex-col gap-5 p-5 sm:flex-1">
    <div class="flex items-center gap-4">
      <a
        class="block shrink-0 text-yellow w-12 h-12 rounded-full hover:text-gray focus:outline-dashed focus:outline-offset-2 focus:outline-2 focus:outline-yellow transition-colors"
        href="/"
        aria-label="Go to home page"
      >
        <LogoGraphic class="w-full h-full" />
      </a>
      <h1 class="text-white text-xl uppercase sm:text-2xl xl:text-3xl">
        Airports I've Been To
      </h1>
    </div>

    <dl class="grid grid-cols-2 gap-x-6 gap-y-3 xl:grid-cols-4">
      {
        passStats.map((stat) => (
          <div class="flex flex-col-reverse">
            <dd class="text-yellow text-2xl font-bold">{stat.value}</dd>
            <dt class="text-gray-400 text-sm uppercase">{stat.label}</dt>
          </div>
        ))
      }
    </dl>

    <p
      class="flex flex-wrap justify-between gap-x-4 gap-y-1 mt-auto pt-4 border-t border-dashed border-gray text-sm"
    >
      <span>
        <span class="text-gray-400 uppercase">Longest flight</span>{" "}
        <span class="whitespace-nowrap">
          <span class="text-white">
            {longestFlight.from} → {longestFlight.to}
          </span>{" "}
          <span class="text-gray-400">
            · {Math.round(longestFlight.miles).toLocaleString("en-US")} mi
          </span>
        </span>
      </span>
      <span class="text-gray-400 whitespace-nowrap">
        ≈ {timesAroundEarth}× around the Earth
      </span>
    </p>
  </div>

  <!-- Tear line between the pass and its stub; the notches only make sense
       when the stub sits beside the pass -->
  <div
    class="relative flex flex-col gap-3 p-5 border-t border-dashed border-yellow sm:w-40 sm:border-t-0 sm:border-l"
  >
    <span
      class="absolute -top-2.5 -left-2.5 size-5 rounded-full border border-yellow bg-black max-sm:hidden"
      aria-hidden="true"></span>
    <span
      class="absolute -bottom-2.5 -left-2.5 size-5 rounded-full border border-yellow bg-black max-sm:hidden"
      aria-hidden="true"></span>

    <dl class="grid grid-cols-3 gap-3 sm:grid-cols-1">
      <div class="flex flex-col-reverse justify-end">
        <dd class="text-yellow text-2xl font-bold">{homeAirport}</dd>
        <dt class="text-gray-400 text-sm uppercase">Home base</dt>
      </div>
      <div class="flex flex-col-reverse justify-end">
        <dd class="text-white">{stats.firstYear}</dd>
        <dt class="text-gray-400 text-sm uppercase">Since</dt>
      </div>
      <div class="flex flex-col-reverse justify-end">
        <dd class="text-white">{stats.totalCountries}</dd>
        <dt class="text-gray-400 text-sm uppercase">Countries</dt>
      </div>
    </dl>

    <svg
      class="w-full h-8 mt-auto text-yellow"
      viewBox={`0 0 ${barcodeWidth} 1`}
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      {
        bars.map((bar) => (
          <rect x={bar.x} width={bar.width} height="1" fill="currentColor" />
        ))
      }
    </svg>
  </div>
</header>
