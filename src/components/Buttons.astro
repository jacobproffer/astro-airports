---
import { airports } from "@data/airports";
---

<ol
  class="grid grid-cols-[repeat(auto-fill,minmax(4.25rem,1fr))] gap-2"
  id="sidebar"
>
  {
    airports.map((airport) => (
      <li>
        <button
          class="py-2 px-3 bg-black border border-yellow cursor-pointer transition-colors duration-200 w-full text-center text-white hover:bg-yellow hover:text-black aria-pressed:bg-yellow aria-pressed:text-black focus:outline-dashed focus:outline-2 focus:outline-offset-2 focus:outline-yellow"
          type="button"
          aria-pressed="false"
          aria-label={`${airport.code}, ${airport.name}`}
          data-airport-select={airport.code}
        >
          {airport.code}
        </button>
      </li>
    ))
  }
</ol>

<script>
  import { onAirportSelect } from "../scripts/selection";

  onAirportSelect((code) => {
    document
      .querySelectorAll<HTMLElement>("#sidebar [data-airport-select]")
      .forEach((button) => {
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.airportSelect === code),
        );
      });
  });
</script>
