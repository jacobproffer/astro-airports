---
import BoardingPass from "@components/BoardingPass.astro";
import Buttons from "@components/Buttons.astro";
import AirportPanel from "@components/AirportPanel.astro";
---

<section
  class="order-2 border-yellow max-md:border-t md:self-auto md:order-1 md:border-r"
>
  <div
    class="relative text-center flex flex-col gap-5 px-5 max-md:p-5 max-md:h-full md:w-full md:min-h-screen md:py-16"
  >
    <div class="flex flex-col gap-5 w-full max-w-2xl mx-auto">
      <BoardingPass />
      <AirportPanel />
      <Buttons />
    </div>
  </div>
</section>
