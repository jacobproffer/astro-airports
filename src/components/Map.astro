---
import type {} from "../types/google-maps";

const apiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY;
---

<!-- Google Maps sets its own inline position on #map, so the wrapper sticks -->
<section class="order-1 w-full h-96 md:h-screen md:sticky md:top-0">
  <div class="w-full h-full" id="map"></div>
</section>

<!-- The Maps callback can fire before the bundled script below has run, so
     record readiness inline and let the bundled script pick it up either way -->
<script is:inline>
  window.initMap = () => {
    window.mapsReady = true;
    window.dispatchEvent(new Event("maps-ready"));
  };
</script>

<script
  async
  defer
  src={`https://maps.googleapis.com/maps/api/js?key=${apiKey}&loading=async&libraries=marker&callback=initMap`}
></script>

<script>
  import { airports, airportsByCode, mapCenter } from "../data/airports";
  import { routeSegments } from "../data/stats";
  import {
    getSelectedAirport,
    onAirportSelect,
    selectAirport,
  } from "../scripts/selection";

  // Advanced markers require a Map ID; DEMO_MAP_ID works but ignores custom styling
  const MAP_ID =
    import.meta.env.PUBLIC_GOOGLE_MAPS_MAP_ID || "DEMO_MAP_ID";
  const ICON_URL = "/images/marker.svg";

  const ROUTE_COLOR = "#677279";
  const HIGHLIGHT_COLOR = "#ffcd05";

  // Matches the old look of one faint line per trip stacking up on busy routes
  const routeOpacity = (count: number) => 1 - 0.8 ** count;

  let initialized = false;

  async function initializeMap(): Promise<void> {
    if (initialized) return;
    initialized = true;

    await google.maps.importLibrary("maps");
    await google.maps.importLibrary("marker");

    const mapElement = document.getElementById("map");
    if (!mapElement) {
      console.error("Map element not found");
      return;
    }

    const map = new google.maps.Map(mapElement, {
      zoom: 3,
      center: mapCenter,
      mapId: MAP_ID,
    });

    const infoWindow = new google.maps.InfoWindow();
    const markers = new Map<
      string,
      { marker: google.maps.marker.AdvancedMarkerElement; icon: HTMLElement }
    >();

    google.maps.event.addListener(map, "click", () => selectAirport(null));
    google.maps.event.addListener(infoWindow, "closeclick", () =>
      selectAirport(null),
    );

    // Add all airport markers
    airports.forEach((airport) => {
      const icon = document.createElement("img");
      icon.src = ICON_URL;
      icon.width = 30;
      icon.height = 30;
      icon.alt = "";
      // Advanced markers anchor at bottom center; the old icon was centered
      icon.style.transform = "translateY(50%)";
      icon.style.transition = "transform 150ms";

      const marker = new google.maps.marker.AdvancedMarkerElement({
        map,
        position: { lat: airport.lat, lng: airport.lng },
        content: icon,
        title: `${airport.code}, ${airport.name}`,
      });
      marker.addEventListener("gmp-click", () => selectAirport(airport.code));

      markers.set(airport.code, { marker, icon });
    });

    // Draw one line per airport pair, however many trips used it
    const routes = routeSegments.map((segment) => ({
      segment,
      line: new google.maps.Polyline({
        path: [segment.from, segment.to].map((code) => ({
          lat: airportsByCode[code].lat,
          lng: airportsByCode[code].lng,
        })),
        strokeColor: ROUTE_COLOR,
        strokeOpacity: routeOpacity(segment.count),
        strokeWeight: 3,
        geodesic: true,
        clickable: false,
        map,
      }),
    }));

    function showSelection(code: string | null): void {
      routes.forEach(({ segment, line }) => {
        const touches = segment.from === code || segment.to === code;
        line.setOptions(
          code === null
            ? {
                strokeColor: ROUTE_COLOR,
                strokeOpacity: routeOpacity(segment.count),
                zIndex: 0,
              }
            : touches
              ? { strokeColor: HIGHLIGHT_COLOR, strokeOpacity: 0.9, zIndex: 1 }
              : { strokeColor: ROUTE_COLOR, strokeOpacity: 0.08, zIndex: 0 },
        );
      });

      markers.forEach(({ icon }, markerCode) => {
        icon.style.transform =
          markerCode === code ? "translateY(50%) scale(1.4)" : "translateY(50%)";
      });

      const selected = code === null ? undefined : markers.get(code);
      if (!code || !selected) {
        infoWindow.close();
        return;
      }

      const airport = airportsByCode[code as keyof typeof airportsByCode];
      const content = document.createElement("strong");
      content.textContent = `${airport.code} · ${airport.name}`;
      infoWindow.setContent(content);
      // Keep focus where the user is; the info window grabs it by default
      infoWindow.open({ map, anchor: selected.marker, shouldFocus: false });
      map.panTo({ lat: airport.lat, lng: airport.lng });
    }

    onAirportSelect(showSelection);
    showSelection(getSelectedAirport());
  }

  if (window.mapsReady) {
    initializeMap();
  } else {
    window.addEventListener("maps-ready", initializeMap, { once: true });
  }
</script>
